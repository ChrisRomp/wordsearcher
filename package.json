{
  "name": "wordsearcher",
  "private": true,
  "version": "0.0.0",
  "description": "Free, kid-safe printable word search puzzle maker",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://chrisromp.github.io/wordsearcher/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisRomp/wordsearcher.git"
  },
  "bugs": {
    "url": "https://github.com/ChrisRomp/wordsearcher/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "build:blocklist": "node scripts/build-blocklist.ts",
    "build:dict": "node scripts/build-dictionaries.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && vite build"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=23.6"
  }
}
